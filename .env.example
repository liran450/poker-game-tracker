# Copy to .env.local. Never commit a filled-in .env.
#
# The anon key is public by design and carries no privileges of its own —
# everything rests on RLS (02-architecture.md#security-model). It is the ONLY
# key that may appear in a client build. A service-role key must never be in the
# client or the repo, in any environment, ever.
#
# Both are unused until step 12; the build reads VITE_SUPABASE_URL early only so
# the CSP's connect-src can name the project origin.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
